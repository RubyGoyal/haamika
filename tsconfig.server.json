{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": false,
    "declarationMap": false
  },
  "include": ["src/server/**/*", "src/shared/**/*"],
  "exclude": ["src/**/__tests__/**", "src/**/*.test.ts"]
}
